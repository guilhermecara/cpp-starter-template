{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Build",
            "type": "shell",
            "command": "cmake --build --preset preset-clang",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "CMake: Run Tests",
            "type": "shell",
            "command": "ctest --preset preset-clang",
            "group": "test",
            "problemMatcher": []
        }
    ]
}